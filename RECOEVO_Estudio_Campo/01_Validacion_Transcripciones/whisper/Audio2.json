  {
   "start": 0.0,
   "end": 5.56,
   "text": "Don Álvaro, aunque usted ya no lo dijo, ¿cuánto lleva aquí en el sector?",
   "avg_logprob": -0.237,
   "no_speech_prob": 0.264
  },
  {
   "start": 5.88,
   "end": 6.98,
   "text": "36 años.",
   "avg_logprob": -0.237,
   "no_speech_prob": 0.264
  },
  {
   "start": 7.16,
   "end": 9.56,
   "text": "Usted me dijo que fue uno de los primeros con local aquí.",
   "avg_logprob": -0.237,
   "no_speech_prob": 0.264
  },
  {
   "start": 9.56,
   "end": 10.64,
   "text": "Juntador, sí señor.",
