   "no_speech_prob": 0.264
  },
  {
   "start": 14.66,
   "end": 16.1,
   "text": "¿Ha mejorado o empeorado?",
   "avg_logprob": -0.237,
   "no_speech_prob": 0.264
  },
  {
   "start": 16.22,
   "end": 21.96,
   "text": "Antes, trató de mejorar cuando empezaron a recoger, porque antes nunca nos cobraban, pero no nos la recogían.",
   "avg_logprob": -0.237,
   "no_speech_prob": 0.264
  },
  {
