   "text": "le pasa medio bulto",
   "avg_logprob": -0.145,
   "no_speech_prob": 0.41
  },
  {
   "start": 295.19,
   "end": 297.17,
   "text": "o las que tengan en el momento",
   "avg_logprob": -0.145,
   "no_speech_prob": 0.41
  },
  {
   "start": 297.17,
   "end": 298.71,
   "text": "cuando pasen los chinos",
   "avg_logprob": -0.145,
   "no_speech_prob": 0.41
  },
  {
   "start": 298.71,
   "end": 300.43,
   "text": "o cuando pasen las señoras",
   "avg_logprob": -0.145,
   "no_speech_prob": 0.41
  },
  {
   "start": 300.43,
   "end": 302.05,
   "text": "que muchas veces reciclan",
   "avg_logprob": -0.145,
   "no_speech_prob": 0.41
  },
  {
   "start": 302.05,
   "end": 304.99,
   "text": "eso es para las personas mayores",
   "avg_logprob": -0.145,
   "no_speech_prob": 0.41
  },
  {
   "start": 304.99,
   "end": 306.85,
   "text": "personas adultas",
   "avg_logprob": -0.145,
   "no_speech_prob": 0.41
  },
  {
   "start": 306.85,
   "end": 308.11,
   "text": "que están reciclando",
   "avg_logprob": -0.145,
   "no_speech_prob": 0.41
  },
  {
   "start": 308.11,
