{
 "file": "Audio4.mp3",
 "duration": 501.2114375,
 "segments": [
  {
   "start": 0.0,
   "end": 4.22,
   "text": "Señor Pérez, buenas tardes. ¿Usted cuánto tiempo lleva viviendo acá en Antigüedad?",
   "avg_logprob": -0.329,
   "no_speech_prob": 0.286
  },
  {
   "start": 4.24,
   "end": 6.24,
   "text": "Yo aquí, unos cuantos años más o menos.",
   "avg_logprob": -0.329,
   "no_speech_prob": 0.286
  },
  {
   "start": 11.55,
   "end": 12.55,
   "text": "¿Pero qué es esto? ¿Periquito?",
   "avg_logprob": -0.329,
   "no_speech_prob": 0.286
  },
  {
   "start": 13.19,
   "end": 16.55,
   "text": "No, vecino, yo acabé de almorzar. ¿Se quiere sentadito?",
   "avg_logprob": -0.329,
   "no_speech_prob": 0.286
  },
  {
   "start": 16.95,
   "end": 22.37,
   "text": "Yo le gasto. Yo sí no, pero si usted lo quiere, yo lo gasto.",
   "avg_logprob": -0.329,
   "no_speech_prob": 0.286
  },
  {
   "start": 23.37,
   "end": 24.23,
   "text": "No, tranquilo.",
   "avg_logprob": -0.329,
   "no_speech_prob": 0.286
  },
  {
   "start": 26.67,
   "end": 27.11,
   "text": "Digamos.",
   "avg_logprob": -0.329,
   "no_speech_prob": 0.286
  },
  {
   "start": 28.29,
   "end": 30.61,
   "text": "Su hombre se me comentaba que llevaba 50 años acá en Antigüedad.",
   "avg_logprob": -0.329,
   "no_speech_prob": 0.286
  },
  {
   "start": 30.61,
   "end": 33.95,
   "text": "Yo tengo ya 50 años de estar aquí en el barrio.",
   "avg_logprob": -0.238,
   "no_speech_prob": 0.142
  },
  {
   "start": 34.45,
   "end": 41.71,
   "text": "Yo tengo fotografías de todo esto cuando era potrero,",
   "avg_logprob": -0.238,
   "no_speech_prob": 0.142
  },
  {
   "start": 41.85,
   "end": 46.51,
   "text": "todo esto de aquí para allá, de la iglesia cuando empezó a ser.",
   "avg_logprob": -0.238,
   "no_speech_prob": 0.142
  },
  {
   "start": 47.19,
   "end": 52.81,
   "text": "Tenemos tres libros hechos por la madre Esther de la comunidad",
   "avg_logprob": -0.238,
   "no_speech_prob": 0.142
  },
  {
   "start": 52.81,
   "end": 56.77,
   "text": "y varias cosas que se han hecho en el barrio.",
   "avg_logprob": -0.238,
   "no_speech_prob": 0.142
  },
  {
   "start": 56.77,
   "end": 61.23,
   "text": "de los mismos tiempos que tengo yo aquí",
   "avg_logprob": -0.23,
   "no_speech_prob": 0.368
  },
  {
   "start": 61.23,
   "end": 62.83,
   "text": "a la parte de aquí abajo",
   "avg_logprob": -0.23,
   "no_speech_prob": 0.368
  },
  {
   "start": 62.83,
   "end": 64.67,
   "text": "tenemos hecho varias casas",
   "avg_logprob": -0.23,
   "no_speech_prob": 0.368
  },
  {
   "start": 64.67,
   "end": 66.53,
   "text": "que construimos con compañeros",
   "avg_logprob": -0.23,
   "no_speech_prob": 0.368
  },
  {
   "start": 66.53,
   "end": 68.91,
   "text": "hicimos varias casas",
   "avg_logprob": -0.23,
   "no_speech_prob": 0.368
  },
  {
   "start": 68.91,
   "end": 70.09,
   "text": "a la madre ser",
   "avg_logprob": -0.23,
   "no_speech_prob": 0.368
  },
  {
   "start": 70.09,
   "end": 73.13,
   "text": "y fuera de lo que le hemos hecho",
   "avg_logprob": -0.23,
   "no_speech_prob": 0.368
  },
  {
   "start": 73.13,
   "end": 73.99,
   "text": "aquí al barrio",
   "avg_logprob": -0.23,
   "no_speech_prob": 0.368
  },
  {
   "start": 73.99,
   "end": 75.55,
   "text": "la iglesia",
   "avg_logprob": -0.23,
   "no_speech_prob": 0.368
  },
  {
   "start": 75.55,
   "end": 78.63,
   "text": "el comedor comunitario",
   "avg_logprob": -0.23,
   "no_speech_prob": 0.368
  },
  {
   "start": 78.63,
   "end": 79.89,
   "text": "allá al mar",
   "avg_logprob": -0.23,
   "no_speech_prob": 0.368
  },
  {
   "start": 79.89,
   "end": 81.37,
   "text": "al de mar",
   "avg_logprob": -0.23,
   "no_speech_prob": 0.368
  },
  {
   "start": 81.37,
   "end": 85.07,
   "text": "con el tema del comedor comunitario",
   "avg_logprob": -0.23,
   "no_speech_prob": 0.368
  },
  {
   "start": 85.07,
   "end": 86.75,
   "text": "usted cree, hablando de",
   "avg_logprob": -0.23,
   "no_speech_prob": 0.368
  },
  {
   "start": 86.75,
   "end": 89.33,
   "text": "orgánicos y basuras, que es lo que genera",
   "avg_logprob": -0.152,
   "no_speech_prob": 0.284
  },
  {
   "start": 89.33,
   "end": 91.27,
   "text": "como tal, pues los comedores",
   "avg_logprob": -0.152,
   "no_speech_prob": 0.284
  },
  {
   "start": 91.27,
   "end": 93.27,
   "text": "todo lo que es comercio, las personas",
   "avg_logprob": -0.152,
   "no_speech_prob": 0.284
  },
  {
   "start": 93.27,
   "end": 94.59,
   "text": "¿usted considera que",
   "avg_logprob": -0.152,
   "no_speech_prob": 0.284
  },
  {
   "start": 94.59,
   "end": 96.29,
   "text": "ha habido una buena gestión de basuras?",
   "avg_logprob": -0.152,
   "no_speech_prob": 0.284
  },
  {
   "start": 97.49,
   "end": 97.85,
   "text": "No",
   "avg_logprob": -0.152,
   "no_speech_prob": 0.284
  },
  {
   "start": 97.85,
   "end": 100.87,
   "text": "siempre se ha luchado",
   "avg_logprob": -0.152,
   "no_speech_prob": 0.284
  },
  {
   "start": 100.87,
   "end": 102.49,
   "text": "contra el asunto de las basuras",
   "avg_logprob": -0.152,
   "no_speech_prob": 0.284
  },
  {
   "start": 102.49,
   "end": 104.91,
   "text": "sobre todo esos porteros así",
   "avg_logprob": -0.152,
   "no_speech_prob": 0.284
  },
  {
   "start": 104.91,
   "end": 106.87,
   "text": "incluso yo hace poco",
   "avg_logprob": -0.152,
   "no_speech_prob": 0.284
  },
  {
   "start": 106.87,
   "end": 108.53,
   "text": "limpiaron ese pedazo ahí",
   "avg_logprob": -0.152,
   "no_speech_prob": 0.284
  },
  {
   "start": 108.53,
   "end": 111.15,
   "text": "y yo puse esa imagen de la Virgen del Carmen",
   "avg_logprob": -0.152,
   "no_speech_prob": 0.284
  },
  {
   "start": 111.15,
   "end": 113.43,
   "text": "a ver si lo respetaban como aquel otro punto",
   "avg_logprob": -0.152,
   "no_speech_prob": 0.284
  },
  {
   "start": 113.43,
   "end": 115.05,
   "text": "que ese otro punto",
   "avg_logprob": -0.152,
   "no_speech_prob": 0.284
  },
  {
   "start": 115.05,
   "end": 116.35,
   "text": "también lo hice yo",
   "avg_logprob": -0.152,
   "no_speech_prob": 0.284
  },
  {
   "start": 116.35,
   "end": 118.59,
   "text": "con la intolerancia de la gente",
   "avg_logprob": -0.125,
   "no_speech_prob": 0.19
  },
  {
   "start": 118.59,
   "end": 120.43,
   "text": "que mataba a la gente sin necesidad",
   "avg_logprob": -0.125,
   "no_speech_prob": 0.19
  },
  {
   "start": 120.43,
   "end": 122.67,
   "text": "los niños",
   "avg_logprob": -0.125,
   "no_speech_prob": 0.19
  },
  {
   "start": 122.67,
   "end": 123.39,
   "text": "las mujeres",
   "avg_logprob": -0.125,
   "no_speech_prob": 0.19
  },
  {
   "start": 123.39,
   "end": 126.91,
   "text": "muchas cosas que hubieron habido aquí en el barrio",
   "avg_logprob": -0.125,
   "no_speech_prob": 0.19
  },
  {
   "start": 126.91,
   "end": 127.49,
   "text": "¿me entiendes?",
   "avg_logprob": -0.125,
   "no_speech_prob": 0.19
  },
  {
   "start": 127.93,
   "end": 130.53,
   "text": "pero en el asunto de las basuras",
   "avg_logprob": -0.125,
   "no_speech_prob": 0.19
  },
  {
   "start": 130.53,
   "end": 131.93,
   "text": "ha sido duro",
   "avg_logprob": -0.125,
   "no_speech_prob": 0.19
  },
  {
   "start": 131.93,
   "end": 134.73,
   "text": "¿por qué? porque la misma comunidad",
   "avg_logprob": -0.125,
   "no_speech_prob": 0.19
  },
  {
   "start": 134.73,
   "end": 135.73,
   "text": "no se presta",
   "avg_logprob": -0.125,
   "no_speech_prob": 0.19
  },
  {
   "start": 135.73,
   "end": 138.31,
   "text": "la misma comunidad no coge un sitio",
   "avg_logprob": -0.125,
   "no_speech_prob": 0.19
  },
  {
   "start": 138.31,
   "end": 139.79,
   "text": "también es cierto",
   "avg_logprob": -0.125,
   "no_speech_prob": 0.19
  },
  {
   "start": 139.79,
   "end": 142.13,
   "text": "es que ese es el detalle",
   "avg_logprob": -0.125,
   "no_speech_prob": 0.19
  },
  {
   "start": 142.13,
   "end": 144.61,
   "text": "que si hubiera un sitio exclusivo para botar",
   "avg_logprob": -0.125,
   "no_speech_prob": 0.19
  },
  {
   "start": 144.61,
   "end": 150.63,
   "text": "la basura, la gente la botaría. Pero la gente muchas veces es perezosa. O vienen de la casa",
   "avg_logprob": -0.116,
   "no_speech_prob": 0.533
  },
  {
   "start": 150.63,
   "end": 155.55,
   "text": "con la bolsa y quedan por las esquinas. En cualquier parte van descargando la basura.",
   "avg_logprob": -0.116,
   "no_speech_prob": 0.533
  },
  {
   "start": 156.43,
   "end": 162.13,
   "text": "El asunto es que la basura se extiende y se riega en el barrio del sencillo por los perros.",
   "avg_logprob": -0.116,
   "no_speech_prob": 0.533
  },
  {
   "start": 163.33,
   "end": 168.11,
   "text": "Los perros se encargan de romper bolsas. Hoy en día, ¿saben qué dice cada perro? Ya",
   "avg_logprob": -0.116,
   "no_speech_prob": 0.533
  },
  {
   "start": 168.11,
   "end": 173.55,
   "text": "no pelean en el mismo puesto donde está la basura. Cada uno coge una bolsa y se abre",
   "avg_logprob": -0.116,
   "no_speech_prob": 0.533
  },
  {
   "start": 173.55,
   "end": 175.35,
   "text": "para un lugar",
   "avg_logprob": -0.209,
   "no_speech_prob": 0.451
  },
  {
   "start": 175.35,
   "end": 179.43,
   "text": "¿Usted cree que ese comportamiento",
   "avg_logprob": -0.209,
   "no_speech_prob": 0.451
  },
  {
   "start": 179.43,
   "end": 180.15,
   "text": "de la gente",
   "avg_logprob": -0.209,
   "no_speech_prob": 0.451
  },
  {
   "start": 180.15,
   "end": 182.59,
   "text": "de dejar la basura en cualquier lugar",
   "avg_logprob": -0.209,
   "no_speech_prob": 0.451
  },
  {
   "start": 182.59,
   "end": 184.75,
   "text": "puede cambiar? ¿Se puede mejorar?",
   "avg_logprob": -0.209,
   "no_speech_prob": 0.451
  },
  {
   "start": 184.85,
   "end": 185.05,
   "text": "Sí",
   "avg_logprob": -0.209,
   "no_speech_prob": 0.451
  },
  {
   "start": 185.05,
   "end": 186.01,
   "text": "¿Cómo?",
   "avg_logprob": -0.209,
   "no_speech_prob": 0.451
  },
  {
   "start": 189.01,
   "end": 190.93,
   "text": "Aquí yo tengo varios compañeros",
   "avg_logprob": -0.209,
   "no_speech_prob": 0.451
  },
  {
   "start": 190.93,
   "end": 192.43,
   "text": "que hemos hablado sobre ese asunto",
   "avg_logprob": -0.209,
   "no_speech_prob": 0.451
  },
  {
   "start": 192.43,
   "end": 194.85,
   "text": "para enseñarle a la gente",
   "avg_logprob": -0.209,
   "no_speech_prob": 0.451
  },
  {
   "start": 194.85,
   "end": 196.53,
   "text": "y enseñarle a reciclar",
   "avg_logprob": -0.209,
   "no_speech_prob": 0.451
  },
  {
   "start": 196.53,
   "end": 198.67,
   "text": "pero es que la gente aquí no",
   "avg_logprob": -0.209,
   "no_speech_prob": 0.451
  },
  {
   "start": 198.67,
   "end": 201.49,
   "text": "aquí los que reciclan son los viciosos",
   "avg_logprob": -0.209,
   "no_speech_prob": 0.451
  },
  {
   "start": 201.49,
   "end": 203.47,
   "text": "¿Por qué?",
   "avg_logprob": -0.209,
   "no_speech_prob": 0.451
  },
  {
   "start": 203.55,
   "end": 207.53,
   "text": "porque ellos necesitan para su bicha, para su traba, para lo de ellos.",
   "avg_logprob": -0.151,
   "no_speech_prob": 0.153
  },
  {
   "start": 208.41,
   "end": 212.83,
   "text": "Pero no, muchas veces nosotros les decimos, no rompan las bolsas, compadre.",
   "avg_logprob": -0.151,
   "no_speech_prob": 0.153
  },
  {
   "start": 213.19,
   "end": 216.27,
   "text": "Abran las bolsas, analicen y dejen eso ahí quieto para no regalas.",
   "avg_logprob": -0.151,
   "no_speech_prob": 0.153
  },
  {
   "start": 216.97,
   "end": 220.69,
   "text": "Ellos a veces llevan la idea, comprenden sobre las cosas,",
   "avg_logprob": -0.151,
   "no_speech_prob": 0.153
  },
  {
   "start": 220.69,
   "end": 224.87,
   "text": "porque aquí hay hartos muchachos que se rebuscan con el reclaje.",
   "avg_logprob": -0.151,
   "no_speech_prob": 0.153
  },
  {
   "start": 225.23,
   "end": 230.47,
   "text": "No muchachos, ancianos, señoras mayores.",
   "avg_logprob": -0.151,
   "no_speech_prob": 0.153
  },
  {
   "start": 230.47,
   "end": 234.19,
   "text": "¿Para usted qué cree que es una buena solución respecto al tema de basuras?",
   "avg_logprob": -0.141,
   "no_speech_prob": 0.041
  },
  {
   "start": 235.83,
   "end": 241.35,
   "text": "Sobre una solución sobre ese tema de basuras tocaría hacer una buena campaña",
   "avg_logprob": -0.141,
   "no_speech_prob": 0.041
  },
  {
   "start": 241.35,
   "end": 246.79,
   "text": "para poner y cotizar la gente, concientizar la gente",
   "avg_logprob": -0.141,
   "no_speech_prob": 0.041
  },
  {
   "start": 246.79,
   "end": 250.63,
   "text": "para que no hagamos esos regueros que tenemos que se den en el barrio.",
   "avg_logprob": -0.141,
   "no_speech_prob": 0.041
  },
  {
   "start": 251.33,
   "end": 259.27,
   "text": "Es como allí están haciendo el monumento ese para hacer el aviso de bienvenida al barrio JJ Rondón, Tihuac.",
   "avg_logprob": -0.141,
   "no_speech_prob": 0.041
  },
  {
   "start": 259.27,
   "end": 261.67,
   "text": "que es ese aviso que está allá",
   "avg_logprob": -0.162,
   "no_speech_prob": 0.159
  },
  {
   "start": 261.67,
   "end": 265.47,
   "text": "es más",
   "avg_logprob": -0.162,
   "no_speech_prob": 0.159
  },
  {
   "start": 265.47,
   "end": 267.49,
   "text": "yo he pensado en encuadrar y quitar",
   "avg_logprob": -0.162,
   "no_speech_prob": 0.159
  },
  {
   "start": 267.49,
   "end": 268.77,
   "text": "esa imagen de ahí",
   "avg_logprob": -0.162,
   "no_speech_prob": 0.159
  },
  {
   "start": 268.77,
   "end": 271.97,
   "text": "porque ya siempre la han respetado",
   "avg_logprob": -0.162,
   "no_speech_prob": 0.159
  },
  {
   "start": 271.97,
   "end": 273.79,
   "text": "y sin embargo yo me pongo",
   "avg_logprob": -0.162,
   "no_speech_prob": 0.159
  },
  {
   "start": 273.79,
   "end": 275.93,
   "text": "de raco por el botadero",
   "avg_logprob": -0.162,
   "no_speech_prob": 0.159
  },
  {
   "start": 275.93,
   "end": 277.69,
   "text": "de basura, porque es que la gente",
   "avg_logprob": -0.162,
   "no_speech_prob": 0.159
  },
  {
   "start": 277.69,
   "end": 278.51,
   "text": "es incociente",
   "avg_logprob": -0.162,
   "no_speech_prob": 0.159
  },
  {
   "start": 278.51,
   "end": 281.95,
   "text": "Su merced, ¿cómo administra",
   "avg_logprob": -0.162,
   "no_speech_prob": 0.159
  },
  {
   "start": 281.95,
   "end": 283.75,
   "text": "su basura? O sea, ¿usted la",
   "avg_logprob": -0.162,
   "no_speech_prob": 0.159
  },
  {
   "start": 283.75,
   "end": 285.91,
   "text": "separa o cómo usted",
   "avg_logprob": -0.162,
   "no_speech_prob": 0.159
  },
  {
   "start": 285.91,
   "end": 287.27,
   "text": "opera? Bueno, sí",
   "avg_logprob": -0.162,
   "no_speech_prob": 0.159
  },
  {
   "start": 287.27,
   "end": 289.37,
   "text": "yo recojo por lo menos",
   "avg_logprob": -0.145,
   "no_speech_prob": 0.41
